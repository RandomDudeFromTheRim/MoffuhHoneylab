# Copy to .env locally; never commit a populated .env. Use chmod 600 on Linux.
# Services bind to loopback by default. Set to the Pi LAN address only when required by a router forward.
HONEYPOT_BIND_ADDRESS=127.0.0.1
COWRIE_SSH_HOST_PORT=2222
COWRIE_TELNET_HOST_PORT=2223
COWRIE_DATA_DIR=/var/lib/honeypot-lab/cowrie
COWRIE_SUBNET=172.29.90.0/24
COWRIE_HONEYPOT_HOSTNAME=lab-honeypot
COWRIE_DSHIELD_ENABLED=false
DSHIELD_USERID=
DSHIELD_AUTH_KEY=

MCBAIT_DATA_DIR=/srv/honeypot-lab/mcbait-data
MCBAIT_ALLOW_WIPE=NO
MCBAIT_STATE=/var/lib/mcbait/state.json
MCBAIT_COMPOSE_DIR=/opt/honeypot-lab/deploy/compose/minecraft
MCBAIT_SUBNET=172.29.91.0/24
MC_EULA_ACCEPTED=FALSE
RCON_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
MCPOT_RCON_PASSWORD=REPLACE_WITH_THE_SAME_RCON_SECRET
MCPOT_RCON_HOST=127.0.0.1
MCPOT_RCON_PORT=25575
MCPOT_BIND=0.0.0.0
MCPOT_PORT=25566
MCPOT_UPSTREAM=127.0.0.1:25567
HONEYPOT_EXCLUDED_MC_NAMES=
HONEYPOT_TRUSTED_PROXY_IPS=
HONEYPOT_TELNET_MASK_IPS=

# Optional outbound integrations. Leave blank to keep them disabled.
ROUTERAI_API_KEY=
HONEYPOT_LLM_BASE_URL=https://api.example.invalid/v1
HONEYPOT_LLM_MODEL=replace-with-an-operator-selected-model
DISCORD_BOT_TOKEN=
DISCORD_OUTPUT_CHANNEL_ID=
ABUSEIPDB_KEY=
ABUSECH_KEY=
