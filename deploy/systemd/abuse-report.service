[Unit]
Description=Dry-run honeypot IP report preview
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/honeypot-lab/honeypot.env
ExecStart=/usr/bin/python3 /opt/honeypot-lab/cowrie/abuse_report.py --dry
TimeoutStartSec=5min
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
LockPersonality=yes
StateDirectory=honeypot-report
