# Copy to /etc/honeypot-lab/mcbait.env, review every path, and chmod 600.
MCBAIT_DATA_DIR=/srv/honeypot-lab/mcbait-data
MCBAIT_COMPOSE_DIR=/opt/honeypot-lab/deploy/compose/minecraft
MCBAIT_ALLOW_WIPE=NO
MCBAIT_STATE=/var/lib/mcbait/state.json
MCPOT_LOG=/var/lib/mcpot/events.jsonl
HONEYPOT_REPORT_DIR=/var/lib/honeypot-lab/reports
